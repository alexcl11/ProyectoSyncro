@{
    Layout = "_Layout";
    ViewData["Title"] = "Ajustes";
    bool esAdmin = (bool)ViewData["EsAdmin"];
    List<Usuario> equipo = (List<Usuario>)ViewData["Equipo"];
}

<div class="settings-container">
    <aside class="settings-nav">
        <button class="settings-nav-item active" onclick="switchTab(this, 'perfil')">Mi Perfil</button>
        <button class="settings-nav-item" onclick="switchTab(this, 'empresa')">Empresa</button>

        @if (esAdmin)
        {
            <button class="settings-nav-item" onclick="switchTab(this, 'equipo')">Gestión de Equipo</button>
        }
    </aside>

    <main class="settings-content">

        <section id="tab-perfil" class="settings-card">
            <h2 class="settings-section-title">Mi Perfil</h2>
            <p class="settings-section-desc">Gestiona tu información personal y cómo te ven los demás.</p>

            <form id="formUsuario" onsubmit="guardarPerfil(event)">
                <div class="settings-form-row">
                    <label class="settings-label">Nombre completo</label>
                    <input type="text" class="form-control" name="nombreUser" value="@ViewData["NombreUser"]" />
                </div>
                <div class="settings-form-row">
                    <label class="settings-label">Email</label>
                    <input type="text" name="email" class="form-control" value="@ViewData["EmailUser"]" />
                </div>
                <button type="submit" class="btn btn-primary">Actualizar Perfil</button>
            </form>
        </section>
        
        <section id="tab-empresa" class="settings-card" style="display: none;">
            <h2 class="settings-section-title">Datos de la Empresa</h2>
            <p class="settings-section-desc">Información general de tu organización.</p>

            <form id="formEmpresa" onsubmit="guardarEmpresa(event)">
                <div class="settings-form-row">
                    <label class="settings-label">CIF de la organización</label>
                    <input type="text" name="cif" class="form-control" value="@ViewData["CifEmpresa"]" @(esAdmin ? "" : "disabled") required />
                </div>

                <div class="settings-form-row">
                    <label class="settings-label">Nombre de la organización</label>
                    <input type="text" name="nombreEmpresa" class="form-control" value="@ViewData["NombreEmpresa"]" @(esAdmin ? "" : "disabled") required />
                </div>

                <div class="settings-form-row">
                    <label class="settings-label">Estado de la cuenta</label>
                    <div class="switch-container">
                        @{
                            // Recuperamos el valor real de la base de datos
                            bool isActiva = ViewData["EmpresaActiva"] != null ? (bool)ViewData["EmpresaActiva"] : true;
                        }
                        <label class="switch">
                            <input type="checkbox" id="empresa-activa-toggle" name="empresaActiva"
                                   @(isActiva ? "checked" : "")
                                   @(esAdmin ? "" : "disabled")
                                   onchange="actualizarTextoEstado(this)">
                            <span class="slider"></span>
                        </label>

                        <span id="estado-text" class="switch-label-text" style="color: @(isActiva ? "#10b981" : "#64748b");">
                            @(isActiva ? "Activa" : "Inactiva")
                        </span>
                    </div>
                    @if (esAdmin)
                    {                            
                        <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 6px;">
                            Si desactivas la empresa, ningún usuario de tu equipo (excepto administradores) podrá acceder al sistema.
                        </p>
                    }
                </div>

                @if (esAdmin)
                {
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                }
            </form>
            <hr style="margin: 30px 0; border: none; border-top: 1px solid var(--border);" />

            <div style="background: #fef2f2; border: 1px solid #f87171; border-radius: 12px; padding: 20px;">
                <h4 style="color: #991b1b; margin-top: 0; margin-bottom: 8px;">Zona de Peligro</h4>
                <p style="font-size: 0.85rem; color: #b91c1c; margin-bottom: 16px;">
                    Eliminar la empresa borrará permanentemente todos los usuarios, tablas, columnas y registros asociados. Esta acción <b>no se puede deshacer</b>.
                </p>
                <button type="button" class="btn" style="background: #dc2626; color: white; border: none;" onclick="confirmarEliminarEmpresa()">
                    <svg class="icon" viewBox="0 0 24 24" style="margin-right: 6px;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    Eliminar Empresa Definitivamente
                </button>
            </div>
            <hr style="margin: 30px 0; border: none; border-top: 1px solid var(--border);" />
            <h3 class="settings-section-title" style="font-size: 1.1rem; margin-bottom: 16px;">Suscripción y Facturación</h3>

            @{
                bool esPremium = ViewData["EsPremium"] != null && (bool)ViewData["EsPremium"];
            }

            @if (esPremium)
            {
                <div style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border-radius: 12px; padding: 24px; color: white; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
                    <div>
                        <div style="display: inline-flex; align-items: center; gap: 6px; background: rgba(52, 211, 153, 0.15); color: #34d399; padding: 4px 12px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; margin-bottom: 12px; border: 1px solid rgba(52, 211, 153, 0.3);">
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            PLAN PREMIUM ACTIVO
                        </div>
                        <h4 style="margin: 0 0 6px; font-size: 1.25rem; font-family: 'Plus Jakarta Sans', sans-serif;">Potencia ilimitada desbloqueada</h4>
                        <p style="margin: 0; color: #94a3b8; font-size: 0.9rem; max-width: 400px;">Tu empresa tiene acceso a tablas infinitas, registros ilimitados y soporte prioritario.</p>
                    </div>
                </div>
            }
            else
            {
                <div style="border: 1px solid var(--border); border-radius: 12px; padding: 24px; display: flex; justify-content: space-between; align-items: center; background: #ffffff; flex-wrap: wrap; gap: 20px; box-shadow: 0 10px 30px rgba(36, 84, 147, 0.05);">
                    <div>
                        <div style="display: inline-block; background: #f1f5f9; color: #64748b; padding: 4px 12px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; margin-bottom: 12px;">PLAN ACTUAL: FREE</div>
                        <h4 style="margin: 0 0 12px; font-size: 1.25rem; color: var(--text-main); font-family: 'Plus Jakarta Sans', sans-serif;">Alcanza el siguiente nivel</h4>
                        <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.9rem; color: var(--text-muted); display: grid; gap: 8px;">
                            <li style="display: flex; align-items: center; gap: 8px;"><svg viewBox="0 0 24 24" width="18" height="18" stroke="var(--brand)" stroke-width="2" fill="none" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg> <b>Tablas ilimitadas</b></li>
                            <li style="display: flex; align-items: center; gap: 8px;"><svg viewBox="0 0 24 24" width="18" height="18" stroke="var(--brand)" stroke-width="2" fill="none" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg> <b>Registros ilimitados</b></li>
                        </ul>
                    </div>
                    <div style="text-align: right; min-width: 200px;">
                        <div style="font-size: 2.5rem; font-weight: 800; color: var(--text-main); font-family: 'Plus Jakarta Sans', sans-serif; margin-bottom: 12px; line-height: 1;">29€ <span style="font-size: 1rem; color: var(--text-muted); font-weight: 600;">/mes</span></div>
                        <a href="/Payment/Checkout" class="btn btn-primary" style="padding: 12px 24px; font-size: 1rem; width: 100%; justify-content: center; text-decoration: none;">Mejorar a Premium</a>
                    </div>
                </div>
            }
        </section>

        @if (esAdmin)
        {
            <section id="tab-equipo" class="settings-card" style="display: none;">
                <div class="team-header-action">
                    <div>
                        <h2 class="settings-section-title">Gestión de Equipo</h2>
                        <p class="settings-section-desc" style="margin-bottom: 0;">Invita a nuevos miembros y gestiona sus permisos.</p>
                    </div>
                    @{
                        // 1. Contamos cuántos usuarios hay actualmente en la lista
                        int cantidadUsuarios = equipo != null ? equipo.Count : 0;

                        // 2. Comprobamos si es Premium (aprovechando la variable que ya creamos antes)
                        bool esPremiumSettings = ViewData["EsPremium"] != null && (bool)ViewData["EsPremium"];
                    }

                    <button type="button" class="btn btn-primary" onclick="intentarCrearUsuario(@cantidadUsuarios, @(esPremiumSettings ? "true" : "false"))">
                        + Nuevo Usuario
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Rol</th>
                                @if (esAdmin)
                                {
                                    <th>Acciones</th>
                                }
                            
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Usuario user in equipo)
                            {                            
                                <tr>
                                    <td>@user.Nombre</td>
                                    <td>@user.Email</td>
                                    @if (user.EsAdmin)
                                    {                                    
                                        <td><span class="chip" style="background: var(--brand); color: white;">Administrador</span></td>
                                    
                                    }
                                    else
                                    {
                                        <td><span class="chip" style="background: var(--brand); color: white;">Empleado</span></td>
                                    }
                                    @if (esAdmin)
                                    {
                                        <td>
                                            <div style="display: flex; gap: 4px;">
                                                <button type="button" class="btn-icon" 
                                                        data-id="@user.IdUsuario"
                                                        data-nombre="@user.Nombre"
                                                        data-email="@user.Email"
                                                        data-admin="@user.EsAdmin.ToString().ToLower()"
                                                        onclick="abrirModalEditarUsuario(this)" title="Editar">
                                                    <svg viewBox="0 0 24 24" style="width: 14px; height: 14px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round;">
                                                        <path d="M12 20h9"></path>
                                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                                    </svg>
                                                </button>

                                                <button type="button" class="btn-icon"
                                                        data-id="@user.IdUsuario"
                                                        data-nombre="@user.Nombre"
                                                        onclick="eliminarUsuario(this)" title="Eliminar">
                                                    <svg viewBox="0 0 24 24" style="width: 14px; height: 14px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round;">
                                                        <polyline points="3 6 5 6 21 6"></polyline>
                                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                    </svg>
                                                </button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

    </main>
</div>
<div class="modal-overlay" id="newUserModal">
    <div class="modal-card">
        <form id="formNewUser" onsubmit="guardarNuevoUsuario(event)">

            <div class="modal-header">
                <h3 class="modal-title">Invitar Nuevo Usuario</h3>
                <button type="button" class="modal-close" onclick="closeAddUserModal()">
                    <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; stroke-width: 2; fill: none;">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="modal-body">
                <div class="form-group" style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; color: var(--text-main);">Nombre completo</label>
                    <input type="text" name="nombre" class="form-control" style="width: 100%; border: 1px solid var(--border); padding: 10px 14px; border-radius: 8px;" placeholder="Ej: Laura Gómez" required>
                </div>

                <div class="form-group" style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; color: var(--text-main);">Correo electrónico</label>
                    <input type="email" name="email" class="form-control" style="width: 100%; border: 1px solid var(--border); padding: 10px 14px; border-radius: 8px;" placeholder="laura@empresa.com" required>
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; color: var(--text-main);">Contraseña provisional</label>
                    <input type="password" name="password" class="form-control" style="width: 100%; border: 1px solid var(--border); padding: 10px 14px; border-radius: 8px;" placeholder="Mínimo 6 caracteres" required minlength="6">
                </div>

                <div class="form-group" style="margin-bottom: 16px; padding: 16px; background: #f8fafc; border-radius: 12px; border: 1px solid var(--border);">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <label style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">Permisos de Administrador</label>
                            <p style="margin: 0; font-size: 0.75rem; color: var(--text-muted);">Puede gestionar la empresa, facturación, añadir o borrar tablas y crear otros usuarios.</p>
                        </div>
                        <div class="switch-container" style="margin-left: 15px; display: flex; align-items: center;">
                            <label class="switch">
                                <input type="checkbox" id="check-es-admin" name="esAdmin" onchange="actualizarTextoAdmin(this)">
                                <span class="slider"></span>
                            </label>
                            <span id="esadmin-text" style="font-size: 0.85rem; font-weight: 700; color: #64748b; margin-left: 8px;">
                                Inactiva
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeAddUserModal()">Cancelar</button>
                <button type="submit" class="btn btn-primary">Crear Usuario</button>
            </div>
        </form>
    </div>
</div>
<div class="modal-overlay" id="editUserModal">
    <div class="modal-card">
        <form id="formEditUser" onsubmit="guardarEdicionUsuario(event)">
            <input type="hidden" name="idUsuario" id="edit-idUsuario" />

            <div class="modal-header">
                <h3 class="modal-title">Editar Usuario</h3>
                <button type="button" class="modal-close" onclick="cerrarModalEditarUsuario()">✕</button>
            </div>

            <div class="modal-body">
                <div class="form-group" style="margin-bottom: 16px;">
                    <label class="settings-label">Nombre</label>
                    <input type="text" name="nombreUser" id="edit-nombre" class="form-control" required>
                </div>

                <div class="form-group" style="margin-bottom: 16px;">
                    <label class="settings-label">Email</label>
                    <input type="email" name="email" id="edit-email" class="form-control" required>
                </div>

                <div class="form-group">
                    <label class="settings-label">Rol de Administrador</label>
                    <div class="switch-container">
                        <label class="switch">
                            <input type="checkbox" name="esAdmin" id="edit-admin">
                            <span class="slider"></span>
                        </label>
                        <span class="switch-label-text">Dar acceso total</span>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="cerrarModalEditarUsuario()">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <script src="~/js/settings.js" asp-append-version="true"></script>
}