
@model List<Dictionary<string, object>>
@{
    var definicionColumnas = ViewData["Columnas"] as List<MetaColumna>;
    var opcionesSelect = ViewData["OpcionesSelect"] as Dictionary<string, List<MetaOpcione>>;
    var opcionesRelacion = ViewData["OpcionesRelacion"] as Dictionary<string, Dictionary<string, string>>;
    var tablas = ViewData["TablasEmpresa"] as List<string>;
}

<div class="table-toolbar">
    <div class="view-tabs">
        <div class="view-tab active">
            <svg class="icon" viewBox="0 0 24 24">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
            Tabla
        </div>
        <div class="view-tab">
            <svg class="icon" viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Calendario
        </div>
        <div class="view-tab">
            <svg class="icon" viewBox="0 0 24 24">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="9" y1="3" x2="9" y2="21"></line>
                <line x1="15" y1="3" x2="15" y2="21"></line>
            </svg>
            Kanban
        </div>
    </div>

    <div style="display: flex; gap: 10px;">
        <button class="btn btn-outline">
            <svg class="icon" viewBox="0 0 24 24">
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            Filtrar
        </button>
        <button class="btn btn-outline">
            <svg class="icon" viewBox="0 0 24 24">
                <path d="M11 5h10M11 9h7M11 13h4M3 17l4 4 4-4M7 21V3"></path>
            </svg>
            Ordenar
        </button>
        <button class="btn btn-primary" onclick="openRecordModal()" type="button">
            <svg class="icon" viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Nuevo Registro
        </button>
    </div>
</div>

<div class="data-table-container">
    @if (definicionColumnas != null && definicionColumnas.Any())
    {
       
        // Función local para elegir el icono SVG según el tipo de dato C#
        string GetIconoPorTipoDato(string tipoDato)
        {
            if (tipoDato == "Select")
            {
                // Icono Lista/Desplegable (Select)
                return "<svg class='th-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round'><line x1='8' y1='6' x2='21' y2='6'></line><line x1='8' y1='12' x2='21' y2='12'></line><line x1='8' y1='18' x2='21' y2='18'></line><line x1='3' y1='6' x2='3.01' y2='6'></line><line x1='3' y1='12' x2='3.01' y2='12'></line><line x1='3' y1='18' x2='3.01' y2='18'></line></svg>";
            }
            if (tipoDato == "Relacion")
            {
                // Icono Vínculo/Enlace (Relación)
                return "<svg class='th-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round'><path d='M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71'></path><path d='M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71'></path></svg>";
            }
            if (tipoDato == "Fecha")
            {
                // Icono Calendario (Fecha)
                return "<svg class='th-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='18' rx='2' ry='2'></rect><line x1='16' y1='2' x2='16' y2='6'></line><line x1='8' y1='2' x2='8' y2='6'></line><line x1='3' y1='10' x2='21' y2='10'></line></svg>";
            }
            if (tipoDato == "Numero" || tipoDato == "Decimal")
            {
                // Icono Numeral (Número)
                return "<svg class='th-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round'><line x1='4' y1='9' x2='20' y2='9'></line><line x1='4' y1='15' x2='20' y2='15'></line><line x1='10' y1='3' x2='8' y2='21'></line><line x1='16' y1='3' x2='14' y2='21'></line></svg>";
            }
            if (tipoDato == "SiNo")
            {
                // Icono Check (Booleano)
                return "<svg class='th-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round'><polyline points='9 11 12 14 22 4'></polyline><path d='M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11'></path></svg>";
            }

            // Por defecto: Icono Texto (Aa)
            return "<svg class='th-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round'><path d='M4 7V4h16v3'></path><path d='M9 20h6'></path><line x1='12' y1='4' x2='12' y2='20'></line></svg>";
        }
        // ---------------------------------------

        <table class="data-table">
            <thead>
                <tr>
                    <th class="col-checkbox">
                        <div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                            <button type="button" id="btn-delete-all" class="btn-icon-danger" style="display: none;" onclick="getFilasABorrar('@ViewData["Title"]')" title="Eliminar filas seleccionadas">
                                <svg class="icon" viewBox="0 0 24 24">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                </svg>
                            </button>

                            <input id="select-all-checkbox" onchange="selectAllCheckBoxes()" type="checkbox" title="Seleccionar todo">
                        </div>
                    </th>

                    @foreach (var colDef in definicionColumnas)
                    {
                        string iconoSvg = GetIconoPorTipoDato(colDef.TipoDato);

                        <th>
                            <div class="th-content" style="display: flex; align-items: center; justify-content: space-between; gap: 10px;">
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    @Html.Raw(iconoSvg)
                                    @colDef.Nombre
                                </div>

                                <div style="display: flex; gap: 4px;">
                                    <button type="button" style="background: transparent; border: none; padding: 2px; cursor: pointer; color: var(--brand);"
                                            onclick="editarColumna('@colDef.Nombre', '@colDef.TipoDato')" title="Editar columna">
                                        <svg viewBox="0 0 24 24" style="width: 14px; height: 14px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round;">
                                            <path d="M12 20h9"></path>
                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                        </svg>
                                    </button>

                                    <button type="button" style="background: transparent; border: none; padding: 2px; cursor: pointer; color: #94a3b8;"
                                            onclick="eliminarColumna('@ViewData["Title"]', '@colDef.Nombre')" title="Eliminar columna">
                                        <svg viewBox="0 0 24 24" style="width: 14px; height: 14px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round;">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if(Model != null && Model.Any())
                {                   
                    @foreach (var fila in Model)
                    {
                        string idFila = fila.Values.First().ToString();;
                        <tr>                        
                            <td class="col-checkbox">
                                <div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px;">

                                    <button type="button" id="btn-delete-@idFila" class="btn-icon-danger" style="display: none;" onclick="deleteRegistro('@ViewData["Title"]','@idFila')" title="Eliminar fila">
                                        <svg class="icon" viewBox="0 0 24 24">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            <line x1="10" y1="11" x2="10" y2="17"></line>
                                            <line x1="14" y1="11" x2="14" y2="17"></line>
                                        </svg>
                                    </button>

                                    <input type="checkbox" class="checkbox-fila" id="checkbox-fila-@idFila" value="@idFila" 
                                    onchange="mostrarBotonDelete(this, '@idFila')">

                                </div>
                            </td>
                            @foreach (var colDef in definicionColumnas)
                            {
                                var nombreColumna = colDef.Nombre;

                                if (nombreColumna.ToLower() != "id" && nombreColumna.ToLower() != "fechacreacion")
                                {
                                
                                    var valor = fila[nombreColumna];

                                    // 3. LAS RELACIONES
                                    if (colDef != null && colDef.TipoDato == "Relacion" && valor != null)
                                    {
                                        string idValor = valor.ToString();
                                        string textoAMostrar = idValor;

                                        // Preparamos las opciones en JSON para el Javascript
                                        string opcionesJson = "[]";

                                        if (opcionesRelacion != null && opcionesRelacion.ContainsKey(nombreColumna))
                                        {
                                            if (opcionesRelacion[nombreColumna].ContainsKey(idValor))
                                            {
                                                textoAMostrar = opcionesRelacion[nombreColumna][idValor];
                                            }
                                            // Empaquetamos el diccionario en un JSON [{"Id":"1", "Valor":"Juan"}, ...]
                                            var listaOpciones = opcionesRelacion[nombreColumna].Select(k => new { Id = k.Key, Valor = k.Value });
                                            opcionesJson = System.Text.Json.JsonSerializer.Serialize(listaOpciones);
                                        }

                                    
                                        <td title="@textoAMostrar"
                                            data-opciones="@opcionesJson"
                                            onclick="hacerCeldaEditable(this, '@idFila', '@nombreColumna', 'Relacion', '@idValor', '@ViewData["Title"]')">
                                            <span class="cell-relation">@textoAMostrar</span>
                                        </td>
                                    }
                                    // 4. LOS SELECTS 
                                    else if (colDef != null && colDef.TipoDato == "Select" && valor != null)
                                    {
                                        string textoValor = valor.ToString();
                                        string colorFondo = "#64748b";
                                        string opcionesJson = "[]";

                                        if (opcionesSelect != null && opcionesSelect.ContainsKey(nombreColumna))
                                        {
                                            var opcionEncontrada = opcionesSelect[nombreColumna].FirstOrDefault(o => o.Valor == textoValor);
                                            if (opcionEncontrada != null && !string.IsNullOrEmpty(opcionEncontrada.Color))
                                            {
                                                colorFondo = opcionEncontrada.Color;
                                            }
                                            // Empaquetamos las opciones [{"Valor":"En Curso", "Color":"#ff0000"}, ...]
                                            var listaOpciones = opcionesSelect[nombreColumna].Select(o => new { o.Valor, o.Color });
                                            opcionesJson = System.Text.Json.JsonSerializer.Serialize(listaOpciones);
                                        }

                                        <td title="@textoValor"
                                            data-opciones="@opcionesJson"
                                            onclick="hacerCeldaEditable(this, '@idFila', '@nombreColumna', 'Select', '@textoValor', '@ViewData["Title"]')">
                                            <span class="chip" style="background-color: @colorFondo; color: #ffffff; border: none;">
                                                @textoValor
                                            </span>
                                        </td>
                                    }
                                    // 5. FECHAS
                                    else if (valor is DateTime fecha)
                                    {
                                        string fechaFormatoInput = fecha.ToString("yyyy-MM-dd");

                                        <td title="@fecha.ToLongDateString()"
                                            onclick="hacerCeldaEditable(this, '@idFila', '@nombreColumna', 'Fecha', '@fechaFormatoInput', '@ViewData["Title"]')">

                                            @fecha.ToString("dd-MM-yyyy")

                                        </td>
                                    }
                                    // 6. CASILLAS SÍ/NO (Booleanos)
                                    else if (colDef != null && colDef.TipoDato == "SiNo")
                                    {
                                        bool isChecked = false;
                                        if (valor != null)
                                        {
                                            // Comprobamos si es true o 1
                                            if (valor is bool bVal) isChecked = bVal;
                                            else if (valor.ToString() == "True" || valor.ToString() == "1") isChecked = true;
                                        }

                                    

                                        <td>
                                            <input type="checkbox"
                                                   @(isChecked ? "checked" : "")
                                                   onchange="actualizarSiNo('@ViewData["Title"]', @idFila, '@nombreColumna', this.checked)">
                                        </td>
                                    }
                                    // 7. TEXTOS Y NÚMEROS NORMALES
                                    else
                                    {
                                        string valorString = valor != null ? valor.ToString() : "";
                                        <td title="@valorString"
                                            onclick="hacerCeldaEditable(this, '@idFila', '@nombreColumna', '@(colDef != null ? colDef.TipoDato : "Texto")', '@valorString', '@ViewData["Title"]')">
                                            @valorString
                                        </td>
                                    }
                                }

                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="padding: 80px 20px; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="background: #f1f5f9; padding: 20px; border-radius: 50%; margin-bottom: 20px;">
                <svg viewBox="0 0 24 24" style="width: 40px; height: 40px; stroke: var(--text-muted); stroke-width: 1.5; fill: none; stroke-linecap: round; stroke-linejoin: round;">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="3" y1="9" x2="21" y2="9"></line>
                    <line x1="9" y1="21" x2="9" y2="9"></line>
                </svg>
            </div>

            <h3 style="margin: 0 0 8px; color: var(--text-main); font-family: 'Plus Jakarta Sans', sans-serif;">Tabla sin columnas</h3>
            <p style="margin: 0 0 24px; color: var(--text-muted); max-width: 400px;">Esta tabla acaba de ser creada. Añade tu primera columna para empezar a guardar datos.</p>
            <button class="btn btn-primary" onclick="openColumnModal()" type="button">
                <svg class="icon" viewBox="0 0 24 24">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Añadir columna
            </button>
        </div>
    }
</div>
    
</div>
<div class="modal-overlay" id="newRecordModal">
    <div class="modal-card">
        <form method="post" asp-controller="Dashboard" asp-action="CreateRegistro">

            @if (string.IsNullOrEmpty(ViewData["Title"]?.ToString()))
            {
                <div class="modal-header">
                    <h3 class="modal-title">Selecciona una tabla</h3>
                    <button type="button" class="modal-close" onclick="closeRecordModal()">
                        <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; stroke-width: 2; fill: none;">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <div class="modal-body" style="text-align: center; padding: 40px 20px;">
                    <div style="background: #fee2e2; width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; color: #dc2626;">
                        <svg class="icon" viewBox="0 0 24 24" style="width: 24px; height: 24px;">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                    </div>
                    <p style="color: var(--text-muted); margin-bottom: 0;">Debes crear o seleccionar una tabla en el menú lateral antes de poder añadirle registros.</p>
                </div>
                <div class="modal-footer" style="justify-content: center;">
                    <button type="button" class="btn btn-primary" onclick="closeRecordModal()">Entendido</button>
                </div>
            }
            else
            {
                <input type="hidden" name="nombreTabla" value="@ViewData["Title"]" />

                <div class="modal-header">
                    <h3 class="modal-title">Nuevo registro en @ViewData["Title"]</h3>
                    <button type="button" class="modal-close" onclick="closeRecordModal()">
                        <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; stroke-width: 2; fill: none;">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <div class="modal-body" style="max-height: 60vh; overflow-y: auto;">
                    @if (definicionColumnas != null && definicionColumnas.Any())
                    {
                        foreach (var columna in definicionColumnas)
                        {
                            <div class="form-group" style="margin-bottom: 16px;">
                                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; color: var(--text-main);">@columna.Nombre</label>
                                @if (columna.TipoDato == "Select")
                                {
                                    <select name="valoresRegistro[@columna.Nombre]" class="form-control" style="width: 100%; border: 1px solid var(--border); padding: 10px 14px; border-radius: 8px; background: #f8fafc; border-color: var(--brand); cursor: pointer;">
                                        @if (opcionesSelect != null && opcionesSelect.ContainsKey(columna.Nombre))
                                        {
                                            foreach (var opcion in opcionesSelect[columna.Nombre])
                                            {
                                                <option value="@opcion.Valor">@opcion.Valor</option>
                                            }
                                        }
                                    </select>
                                }
                                else if (columna.TipoDato == "Relacion")
                                {
                                    <select name="valoresRegistro[@columna.Nombre]" class="form-control" style="width: 100%; border: 1px solid var(--border); padding: 10px 14px; border-radius: 8px; background: #f8fafc; border-color: var(--brand); cursor: pointer;">
                                        <option value="">Vincular registro...</option>
                                        @if (opcionesRelacion != null && opcionesRelacion.ContainsKey(columna.Nombre))
                                        {
                                            foreach (var relacion in opcionesRelacion[columna.Nombre])
                                            {
                                                <option value="@relacion.Key">@relacion.Value</option>
                                            }
                                        }
                                    </select>
                                }
                                else if (columna.TipoDato == "Fecha")
                                {
                                    <input type="date" name="valoresRegistro[@columna.Nombre]" class="form-control" style="width: 100%; border: 1px solid var(--border); padding: 10px 14px; border-radius: 8px; background: #f8fafc;">
                                }
                                else if (columna.TipoDato == "SiNo")
                                {
                                    <input type="checkbox" name="valoresRegistro[@columna.Nombre]" class="form-control" style="width: 10%; border: 1px solid var(--border); padding: 10px 14px; border-radius: 8px; background: #f8fafc;">
                                }
                                else if (columna.TipoDato == "Numero" || columna.TipoDato == "Decimal")
                                {
                                    <input type="number" name="valoresRegistro[@columna.Nombre]" class="form-control" style="width: 100%; border: 1px solid var(--border); padding: 10px 14px; border-radius: 8px; background: #f8fafc;">
                                }
                                else
                                {
                                    <input type="text" name="valoresRegistro[@columna.Nombre]" class="form-control" style="width: 100%; border: 1px solid var(--border); padding: 10px 14px; border-radius: 8px; background: #f8fafc;">
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div style="padding: 20px; text-align: center; color: var(--text-muted);">
                            <p>Aún no hay columnas configuradas para esta tabla.</p>
                        </div>
                    }
                </div>

                @if (definicionColumnas != null && definicionColumnas.Any())
                {
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline" onclick="closeRecordModal()">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar Registro</button>
                    </div>
                }
            }
        </form>
    </div>
</div>
<div class="modal-overlay" id="newColumnModal">
    <div class="modal-card">
        <form method="post" asp-controller="Dashboard" asp-action="CreateColumn">

            
            @if (string.IsNullOrEmpty(ViewData["Title"]?.ToString()))
            {
                <div class="modal-header">
                    <h3 class="modal-title">Selecciona una tabla</h3>
                    <button type="button" class="modal-close" onclick="closeColumnModal()">
                        <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; stroke-width: 2; fill: none;">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <div class="modal-body" style="text-align: center; padding: 40px 20px;">
                    <div style="background: #fee2e2; width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; color: #dc2626;">
                        <svg class="icon" viewBox="0 0 24 24" style="width: 24px; height: 24px;">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                    </div>
                    <p style="color: var(--text-muted); margin-bottom: 0;">Debes crear o seleccionar una tabla en el menú lateral antes de poder añadirle columnas.</p>
                </div>
                <div class="modal-footer" style="justify-content: center;">
                    <button type="button" class="btn btn-primary" onclick="closeColumnModal()">Entendido</button>
                </div>
            }
            else
            {
                
                <input type="hidden" name="nombreTabla" value="@ViewData["Title"]" />

                <div class="modal-header">
                    <h3 class="modal-title">Añadir columna a @ViewData["Title"]</h3>
                    <button type="button" class="modal-close" onclick="closeColumnModal()">
                        <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; stroke-width: 2; fill: none;">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <div class="modal-body">
                    <div class="form-group" style="margin-bottom: 16px;">
                        <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px;">Nombre de la columna</label>
                        <input type="text" name="nombreColumna" class="form-control" style="width: 100%; border: 1px solid var(--border); padding: 10px 14px; border-radius: 8px;" placeholder="Ej: Teléfono, Fecha de Entrega..." required>
                    </div>

                    <div class="form-group" style="margin-bottom: 16px;">
                        <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px;">Tipo de Dato</label>
                        <select name="tipoDato" id="selectTipoDato" class="form-control" onchange="toggleCamposDinamicos()" style="width: 100%; border: 1px solid var(--border); padding: 10px 14px; border-radius: 8px; cursor: pointer;" required>
                            <option value="Texto">Texto corto</option>
                            <option value="Numero">Número entero</option>
                            <option value="Decimal">Número decimal</option>
                            <option value="Fecha">Fecha</option>
                            <option value="SiNo">Casilla (Sí/No)</option>
                            <option value="Select">Desplegable (Opciones)</option>
                            <option value="Relacion">Vincular con otra tabla</option>
                        </select>
                    </div>

                    <div class="form-group" id="divRelacion" style="display: none; padding: 16px; background: #eef2ff; border-radius: 12px; border: 1px dashed #c7d2fe;">
                        <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--brand); margin-bottom: 8px;">¿A qué tabla quieres apuntar?</label>
                        <select name="nombreTablaRelacionada" class="form-control" style="width: 100%; border: 1px solid #c7d2fe; padding: 10px 14px; border-radius: 8px;">
                            <option value="">Selecciona una tabla...</option>
                            @if (tablas != null)
                            {
                                foreach (string t in tablas)
                                {
                                    <option>@t</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group" id="divOpcionesSelect" style="display: none; padding: 16px; background: #f8fafc; border-radius: 12px; border: 1px dashed var(--border);">
                        <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--text-main); margin-bottom: 12px;">Configurar opciones</label>

                        <div id="opcionesContainer">
                            <div class="opcion-row" style="display: flex; gap: 8px; margin-bottom: 8px;">
                                <input type="text" name="opcionesValor" class="form-control" placeholder="Ej: En Curso" style="flex: 1; margin: 0;">
                                <input type="color" name="opcionesColor" class="form-control" value="#3b82f6" style="width: 50px; padding: 2px; height: 38px; cursor: pointer;" title="Color de etiqueta">
                                <button type="button" class="btn btn-outline" onclick="eliminarOpcion(this)" style="padding: 8px 12px; margin: 0; color: #dc2626;">✕</button>
                            </div>
                        </div>

                        <button type="button" class="btn btn-outline" onclick="agregarOpcion()" style="width: 100%; margin-top: 8px; border-style: dashed;">+ Añadir otra opción</button>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" onclick="closeColumnModal()">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Crear Columna</button>
                </div>
            }
        </form>
    </div>
</div>
<div class="modal-overlay" id="editColumnModal">
    <div class="modal-card">
        <form id="formEditColumn" onsubmit="guardarEdicionColumna(event)">

            <input type="hidden" name="nombreTabla" value="@ViewData["Title"]" />
            <input type="hidden" name="nombreOld" id="edit-nombreOld" value="" />

            <div class="modal-header">
                <h3 class="modal-title">Editar columna</h3>
                <button type="button" class="modal-close" onclick="closeEditColumnModal()">
                    <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; stroke-width: 2; fill: none;">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="modal-body">
                <div class="form-group" style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px;">Nombre de la columna</label>
                    <input type="text" name="nombreNew" id="edit-nombreNew" class="form-control" style="width: 100%; border: 1px solid var(--border); padding: 10px 14px; border-radius: 8px;" required>
                </div>

                <div class="form-group" style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px;">Tipo de Dato</label>
                    <select name="tipoDato" id="edit-tipoDato" class="form-control" onchange="toggleEditCamposDinamicos()" style="width: 100%; border: 1px solid var(--border); padding: 10px 14px; border-radius: 8px; cursor: pointer;" required>
                        <option value="Texto">Texto corto</option>
                        <option value="Numero">Número entero</option>
                        <option value="Decimal">Número decimal</option>
                        <option value="Fecha">Fecha</option>
                        <option value="SiNo">Casilla (Sí/No)</option>
                        <option value="Select">Desplegable (Opciones)</option>
                        <option value="Relacion">Vincular con otra tabla</option>
                    </select>
                </div>

                <div class="form-group" id="edit-divRelacion" style="display: none; padding: 16px; background: #eef2ff; border-radius: 12px; border: 1px dashed #c7d2fe;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--brand); margin-bottom: 8px;">¿A qué tabla quieres apuntar?</label>
                    <select name="nombreTablaRelacionada" id="edit-nombreTablaRelacionada" class="form-control" style="width: 100%; border: 1px solid #c7d2fe; padding: 10px 14px; border-radius: 8px;">
                        <option value="">Selecciona una tabla...</option>
                        @if (tablas != null)
                        {
                            foreach (string t in tablas)
                            {
                                <option value="@t">@t</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group" id="edit-divOpcionesSelect" style="display: none; padding: 16px; background: #f8fafc; border-radius: 12px; border: 1px dashed var(--border); margin-top: 16px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--text-main); margin-bottom: 12px;">Añadir nuevas opciones</label>
                    <div id="edit-opcionesContainer"></div>
                    <button type="button" class="btn btn-outline" onclick="agregarOpcionEdit()" style="width: 100%; margin-top: 8px; border-style: dashed;">+ Añadir opción</button>
                </div>

                <div style="margin-top: 15px; font-size: 0.8rem; color: #d97706; background: #fef3c7; padding: 12px; border-radius: 8px; border: 1px solid #fde68a;">
                    ⚠️ <b>Atención:</b> Cambiar el tipo de dato en una tabla con registros existentes puede fallar si los datos no son compatibles.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeEditColumnModal()">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>