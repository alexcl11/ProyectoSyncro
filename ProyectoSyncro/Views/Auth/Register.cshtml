@{
    Layout = null; // Apagamos el layout principal
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <title>Syncro - Crear cuenta</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --brand: #245493;
            --brand-dark: #1b4072;
            --bg: #f8fafc;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --shadow: 0 12px 40px rgba(15, 23, 42, 0.08);
        }

        body {
            margin: 0;
            font-family: 'Manrope', sans-serif;
            background: var(--bg);
            color: var(--text-main);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }

        /* Añade esto a tus estilos */
        .auth-nav {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            padding: 24px 40px;
            display: flex;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.25rem;
            color: var(--text-main);
            text-decoration: none;
            transition: opacity 0.2s;
        }

            .brand:hover {
                opacity: 0.8;
            }

            .brand img {
                height: 32px;
            }

        /* Busca la clase .auth-page que ya tienes y cámbiala por esta (le añadimos position relative y un poco más de padding arriba) */
        .auth-page {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: var(--bg);
            padding: 100px 20px 40px;
        }

        .auth-card {
            background: #fff;
            border-radius: 24px;
            padding: 40px;
            width: 100%;
            max-width: 480px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
        }

        .auth-header {
            text-align: center;
            margin-bottom: 30px;
        }

            .auth-header img {
                height: 40px;
                margin-bottom: 16px;
            }

            .auth-header h2 {
                font-family: 'Plus Jakarta Sans', sans-serif;
                margin: 0 0 8px;
                font-size: 1.5rem;
            }

            .auth-header p {
                color: var(--text-muted);
                margin: 0;
                font-size: 0.95rem;
            }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                font-size: 0.85rem;
                font-weight: 600;
                margin-bottom: 8px;
            }

        .form-control {
            width: 100%;
            box-sizing: border-box;
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px 16px;
            font-family: inherit;
            font-size: 0.95rem;
            transition: all 0.2s;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--brand);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(36, 84, 147, 0.1);
            }

        .btn {
            width: 100%;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            font-family: inherit;
            transition: all 0.2s;
        }

        .btn-primary {
            background: var(--brand);
            color: #fff;
            margin-top: 10px;
        }

            .btn-primary:hover {
                background: var(--brand-dark);
                transform: translateY(-2px);
            }

        .auth-footer {
            text-align: center;
            margin-top: 24px;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

            .auth-footer a {
                color: var(--brand);
                font-weight: 700;
                text-decoration: none;
            }

                .auth-footer a:hover {
                    text-decoration: underline;
                }

        .back-link {
            display: inline-block;
            margin-bottom: 24px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            transition: color 0.2s, transform 0.2s;
        }

            .back-link:hover {
                color: var(--brand);
                transform: translateX(-2px); /* Pequeño efecto de movimiento hacia la izquierda */
            }
    </style>
</head>
<body>
    <nav class="auth-nav">
        <a class="brand" href="/">
            <img src="~/img/logo.png" alt="Syncro Logo" />
        </a>
    </nav>

    <div class="auth-card">
        <a href="/" class="back-link">← Volver a la web</a>
        <div class="auth-header">
            <img src="~/img/logo.png" alt="Syncro Logo" />
            <h2>Crea tu espacio</h2>
            <p>Configura la cuenta de tu empresa en segundos.</p>
        </div>

        <form action="#" method="post">
            <div class="form-group">
                <label>Nombre de la Empresa</label>
                <input type="text" class="form-control" placeholder="Ej. JL Marlo Renovation" required />
            </div>

            <div class="form-group">
                <label>CIF / NIF</label>
                <input type="text" class="form-control" placeholder="B12345678" required />
            </div>

            <div class="form-group">
                <label>Tu Nombre Completo</label>
                <input type="text" class="form-control" placeholder="Alejandro Cánovas" required />
            </div>

            <div class="form-group">
                <label>Email de trabajo</label>
                <input type="email" class="form-control" placeholder="hola@tuempresa.com" required />
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <input type="password" class="form-control" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn btn-primary">Crear cuenta</button>
        </form>

        <div class="auth-footer">
            ¿Ya tienes cuenta? <a href="/Auth/Login">Inicia sesión aquí</a>
        </div>
    </div>

</body>
</html>