@{
    Layout = null; // Apagamos el layout principal
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <title>Syncro - Crear cuenta</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
    <style>
        
    </style>
</head>
<body>
    <nav class="auth-nav">
        <a class="brand" href="/">
            <img src="~/img/logo.png" alt="Syncro Logo" />
        </a>
    </nav>

    <div class="auth-card">
        <a href="/" class="back-link">← Volver a la web</a>
        <div class="auth-header">
            <img src="~/img/logo.png" alt="Syncro Logo" />
            <h2>Crea tu espacio</h2>
            <p>Configura la cuenta de tu empresa en segundos.</p>
        </div>

        <form method="post">
            <input type="hidden" name="plan" value="@ViewData["PlanSeleccionado"]" />

            @if (ViewData["PLANSELECCIONADO"].ToString() == "premium")
            {
                <div style="background: #eff6ff; border: 1px solid #3b82f6; padding: 10px; border-radius: 8px; margin-bottom: 20px; text-align: center; color: #1e3a8a; font-size: 0.9rem;">
                    ✨ Estás registrándote para el <b>Plan Premium</b>. <br>El pago se realizará en el siguiente paso.
                </div>
            }
            <div class="form-group">
                <label>Nombre de la Empresa</label>
                <input type="text" class="form-control" name="nombreEmpresa" placeholder="Ej. JL Marlo Renovation" required />
            </div>

            <div class="form-group">
                <label>CIF / NIF</label>
                <input type="text" class="form-control" name="cif" placeholder="B12345678" required />
            </div>

            <div class="form-group">
                <label>Tu Nombre Completo</label>
                <input type="text" class="form-control" name="nombreAdmin" placeholder="Alejandro Cánovas" required />
            </div>

            <div class="form-group">
                <label>Email de trabajo</label>
                <input type="email" class="form-control" name="email" placeholder="hola@tuempresa.com" required />
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <input type="password" class="form-control" name="password" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn btn-primary">Crear cuenta</button>
        </form>

        <div class="auth-footer">
            ¿Ya tienes cuenta? <a href="/Auth/Login">Inicia sesión aquí</a>
        </div>
    </div>
    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: '@TempData["Success"]',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'Ir a Login'
            }).then(() => {
                window.location.href = '/Auth/Login';
            });;
        </script>
    }
    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: '@TempData["Error"]',
                confirmButtonColor: '#d33'
            });
        </script>
    }
</body>
</html>