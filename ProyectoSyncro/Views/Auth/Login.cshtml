@{
    Layout = null; // Apagamos el layout principal
    string mensaje = (string)ViewData["MENSAJE"];
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <title>Syncro - Iniciar sesión</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <nav class="auth-nav">
        <a class="brand" href="/">
            <img src="~/img/logo.png" alt="Syncro Logo" />
        </a>
    </nav>

    <div class="auth-card">
        <a href="/" class="back-link">← Volver a la web</a>
        <div class="auth-header">
            <img src="~/img/logo.png" alt="Syncro Logo" />
            @if (mensaje != null)
            {
                <h2>Bienvenido de nuevo</h2>
                <p class="text-success">@mensaje</p>
            }
            else
            {
                <h2>Bienvenido de nuevo</h2>
                <p>Ingresa a tu espacio de trabajo.</p>
            }
            
        </div>

        <form method="post">
            <div class="form-group">
                <label>Email</label>
                <input type="email" class="form-control" name="email" placeholder="hola@tuempresa.com" required />
            </div>

            <div class="form-group">
                <label style="display: flex; justify-content: space-between;">
                    Contraseña
                    <a href="javascript:void(0)" onclick="solicitarRecuperacion()" style="color: var(--brand); font-weight: 600; text-decoration: none;">¿Olvidaste tu clave?</a>
                </label>
                <input type="password" class="form-control" name="password" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn btn-primary">Entrar</button>
        </form>

        <div class="auth-footer">
            ¿No tienes cuenta? <a href="/Auth/Register">Regístrate gratis</a>
        </div>
    </div>
    @if (TempData["InvalidCredentials"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: '@TempData["InvalidCredentials"]',
                confirmButtonColor: '#d33'
            });
        </script>
    }

    <script>
        function solicitarRecuperacion() {
            Swal.fire({
                title: 'Recuperar contraseña',
                text: 'Introduce el correo electrónico asociado a tu cuenta.',
                input: 'email',
                inputPlaceholder: 'hola@tuempresa.com',
                showCancelButton: true,
                confirmButtonText: 'Enviar enlace',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#2563eb',
                cancelButtonColor: '#64748b',
                showLoaderOnConfirm: true,
                preConfirm: (email) => {
                    // Creamos el form para enviarlo al controlador MVC
                    var formData = new FormData();
                    formData.append('email', email);

                    return fetch('/Auth/RecuperarPassword', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Error al enviar la solicitud.');
                        }
                        return response.json();
                    })
                    .catch(error => {
                        Swal.showValidationMessage(`Ocurrió un error: ${error.message}`);
                    });
                },
                allowOutsideClick: () => !Swal.isLoading()
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: '¡Correo enviado!',
                        text: 'Si existe una cuenta con ese correo, recibirás un enlace para restablecer tu contraseña en unos minutos.',
                        icon: 'success',
                        confirmButtonColor: '#2563eb'
                    });
                }
            });
        }
    </script>
</body>
</html>