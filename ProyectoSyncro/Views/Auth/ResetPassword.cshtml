@{
    Layout = null;
    string token = (string)ViewData["TOKEN_RESET"];
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Syncro - Restablecer Contraseña</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <nav class="auth-nav">
        <a class="brand" href="/"><img src="~/img/logo.png" alt="Syncro Logo" /></a>
    </nav>
    <div class="auth-card">
        <div class="auth-header">
            <h2>Crear nueva contraseña</h2>
            <p>Introduce tu nueva contraseña a continuación.</p>
        </div>

        <form asp-action="RestablecerClave" asp-controller="Auth" method="post">
            <input type="hidden" name="token" value="@token" />

            <div class="form-group">
                <label>Nueva contraseña</label>
                <input type="password" class="form-control" name="password" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top:20px;">Actualizar contraseña</button>
        </form>
    </div>
</body>
</html>