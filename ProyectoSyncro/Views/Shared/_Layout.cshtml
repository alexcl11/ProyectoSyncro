<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
    @{
        if (ViewData["Title"] != null)
        {
            <title>@ViewData["Title"] - Syncro</title>
        }
        else
        {
            <title>Dashboard - Syncro</title>
        }
    }

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-header">
            <img src="~/img/logo.png" alt="Syncro Logo" style="height:50px; width:auto">
        </div>

        <nav class="sidebar-nav">
            <div style="display: flex; justify-content: space-between; align-items: center; padding-right: 15px;">
                <div class="nav-label" style="margin: 0;">Tus Tablas</div>

                <button type="button" id="btn-delete-tablas" style="display: none; background: transparent; border: none; color: #dc2626; cursor: pointer; padding: 4px;" onclick="getTablasABorrar()" title="Eliminar tablas seleccionadas">
                    <svg class="icon" viewBox="0 0 24 24" style="width: 16px; height: 16px; stroke: currentColor; stroke-width: 2; fill: none;">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        <line x1="10" y1="11" x2="10" y2="17"></line>
                        <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                </button>
            </div>

            @{
                var TablasEmpresa = ViewData["TablasEmpresa"] as List<string>;
            }

            @if (TablasEmpresa != null && TablasEmpresa.Any())
            {
                <ul style="list-style: none; padding: 0; margin: 0;">
                    @foreach (string tabla in TablasEmpresa)
                    {
                        <li style="display: flex; align-items: center; padding: 0 15px;">
                            <input type="checkbox" class="checkbox-tabla" value="@tabla" onchange="mostrarPapeleraTablas()" style="cursor: pointer; margin-right: 8px;">

                            <a asp-controller="Dashboard" asp-action="Index" asp-route-tabla="@tabla" class="nav-item" style="flex: 1; margin: 0;">
                                @tabla
                            </a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div style="padding: 10px 15px; font-size: 0.8rem; color: var(--text-muted);">
                    Aún no tienes tablas.
                </div>
            }

            <a href="#" class="nav-item" onclick="openModal()" style="color: var(--brand); margin-top: 15px; border: 1px dashed #cbd5e1; background: transparent;">
                <svg class="nav-icon" viewBox="0 0 24 24">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Nueva Tabla
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="user-company" style="display: flex; align-items: center; gap: 8px;">
                <svg class="icon" viewBox="0 0 24 24" style="width: 16px; height: 16px; color: var(--brand);">
                    <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                    <line x1="12" y1="18" x2="12.01" y2="18"></line>
                    <line x1="8" y1="18" x2="8.01" y2="18"></line>
                    <line x1="16" y1="18" x2="16.01" y2="18"></line>
                    <line x1="12" y1="14" x2="12.01" y2="14"></line>
                    <line x1="8" y1="14" x2="8.01" y2="14"></line>
                    <line x1="16" y1="14" x2="16.01" y2="14"></line>
                    <line x1="12" y1="10" x2="12.01" y2="10"></line>
                    <line x1="8" y1="10" x2="8.01" y2="10"></line>
                    <line x1="16" y1="10" x2="16.01" y2="10"></line>
                </svg>
                @ViewData["NombreEmpresa"]
            </div>

            <div class="user-name" style="display: flex; align-items: center; gap: 8px; margin-top: 6px; margin-bottom: 12px;">
                <svg class="icon" viewBox="0 0 24 24" style="width: 16px; height: 16px;">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                @ViewData["NombreUser"]
            </div>

            <btn onclick="confirmarCerrarSesion(event)" class=" btn text-danger" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                <svg class="icon" viewBox="0 0 24 24" style="width: 14px; height: 14px; stroke: currentColor;">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                Cerrar sesión
            </btn>
        </div>
    </aside>

    <main class="main-content">
        <header class="topbar">
            <div class="topbar-title" style="display: flex; align-items: center; gap: 10px;">
                <svg viewBox="0 0 24 24" style="width: 22px; height: 22px; stroke: var(--text-muted); stroke-width: 2.2; fill: none; stroke-linecap: round; stroke-linejoin: round;">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="3" y1="9" x2="21" y2="9"></line>
                    <line x1="9" y1="21" x2="9" y2="9"></line>
                </svg>
                @ViewData["Title"]
            </div>

            <div style="display: flex; gap: 10px;">
                <button class="btn btn-outline">
                    <svg class="icon" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                    Ajustes
                </button>
                @{
                    if (ViewData["Title"] != null)
                    {                        
                        <button type="button" class="btn btn-primary" style="display: flex; align-items: center; gap: 8px;" onclick="openColumnModal()">
                            <svg class="nav-icon" viewBox="0 0 24 24">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Añadir Columna
                        </button>
                    }
                }
            </div>
        </header>

        <div class="content-area">
            @RenderBody()                       
        </div>
    </main>

    <div class="modal-overlay" id="newTableModal">
        <div class="modal-card">
            <div class="modal-header">
                <h3 class="modal-title">Crear nueva tabla</h3>
                <button class="modal-close" onclick="closeModal()">
                    <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; stroke-width: 2; fill: none;">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <form method="post" asp-controller="Base" asp-action="Create">
                <div class="modal-body">
                
                
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px;">Nombre de la tabla</label>
                        <input type="text" name="nombreTabla" class="form-control" style="width: 100%; border: 1px solid var(--border); padding: 10px 14px; border-radius: 8px;" placeholder="Ej: Facturas, Empleados, Inventario...">
                    </div>

                    <div class="form-group">
                        <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px;">Elige un icono</label>
                        <div class="icon-grid">
                            <div class="icon-option selected">
                                <svg class="icon" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                            </div>
                            <div class="icon-option">
                                <svg class="icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            </div>
                            <div class="icon-option">
                                <svg class="icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            </div>
                            <div class="icon-option">
                                <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            </div>
                            <div class="icon-option">
                                <svg class="icon" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                            </div>
                            <div class="icon-option">
                                <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" onclick="closeModal()">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Crear Tabla</button>
                </div>
            </form>
        </div>
    </div>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>